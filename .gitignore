# Local environments, Python caches and packaging outputs.
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Large external inputs and generated outputs; configs/ and results/ stay tracked.
/data/
/external/
/artifacts/
*.pt
*.pth
*.onnx
# Archives and media anywhere in the tree (datasets, demo clips, annotated outputs).
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.part
*.mp4
*.avi
*.mov
*.mkv
# Syncthing exclusions for these folders live in the College folder's .stignore.

# Credentials and machine-local secrets.
.env
.env.*
!.env.example
.aws/
credentials/
secrets/
*.pem
*.key

# Editor, notebook, operating-system and temporary files.
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# Spec Kit's existing .specify/.gitignore owns machine-local feature state.
